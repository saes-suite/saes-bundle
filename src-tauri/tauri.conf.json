{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAES",
  "version": "1.0.1",
  "identifier": "com.saes.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../saes-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../saes-ui build",
    "frontendDist": "../saes-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAES — Algorithm Evaluation Suite",
        "width": 1400,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/saes-backend/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
